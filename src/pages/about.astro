---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About — Your Name"
  description="A customizable about page for a mapping and data-visualization portfolio."
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 pt-16 pb-12">
    <h1 class="font-display text-3xl sm:text-4xl font-bold">About</h1>

    <div class="prose-map mt-8">
      <p>
        Hi! I'm Your Name — a cartographer and data storyteller interested in using
        maps to make complex places and patterns easier to understand.
      </p>
      <p>
        Use this page to introduce your focus, working style, and the questions that
        motivate you. Keep it concise, specific, and written in your own voice.
      </p>

      <h2>Background</h2>
      <ul>
        <li>
          <strong>Current role</strong> — Organization, specialty, and one sentence
          about the work you do.
        </li>
        <li>
          <strong>Previous role</strong> — Organization, specialty, and a concise
          description of your contribution.
        </li>
        <li>
          <strong>Earlier role or project</strong> — Add another relevant experience,
          or remove this item.
        </li>
      </ul>

      <h2>Education</h2>
      <ul>
        <li>
          Degree or certificate — Institution
        </li>
        <li>
          Degree or certificate — Institution
        </li>
      </ul>

      <h2>Toolbox</h2>
      <p>QGIS · ArcGIS Pro · JavaScript · Python · Data visualization</p>

      <p>
        Find me on
        <a href="https://www.linkedin.com/" target="_blank" rel="noopener me">LinkedIn</a>.
      </p>
    </div>
  </section>
</BaseLayout>
