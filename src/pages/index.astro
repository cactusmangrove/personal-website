---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MapCard from '../components/MapCard.astro';

const maps = (await getCollection('maps', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latest = maps.slice(0, 3);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Reka Toth — Geoecology, maps & designs"
  description="Reka Toth is an interdisciplinary geography and geoecology graduate student learning to work in ecological restoration with a focus on water-cycle restoration and soil health."
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-16 sm:pt-24 pb-12">
    <h1 class="font-display text-4xl sm:text-5xl font-bold leading-tight max-w-2xl">
      Connecting <span class="text-primary">land, systems</span> and making
    </h1>
    <p class="mt-6 text-lg text-text-muted max-w-2xl leading-relaxed">
      I’m Reka Toth, an interdisciplinary geography and geoecology graduate student based in
      Vienna. My work connects ecological questions with technical, design, and
      stakeholder perspectives — from wetlands, soil health, and water-cycle
      restoration. Alongside, I am following my curiosity about circular footwear production.
    </p>
    <div class="mt-8 flex gap-4">
      <a
        href={`${base}/maps`}
        class="bg-primary text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-primary-dark transition-colors"
      >
        Explore maps
      </a>
      <a
        href={`${base}/about`}
        class="px-5 py-2.5 rounded-lg text-sm font-medium border border-border text-text hover:border-primary hover:text-primary transition-colors"
      >
        About me
      </a>
    </div>
  </section>

  {latest.length > 0 && (
    <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="font-display text-2xl font-semibold">Latest maps</h2>
        <a href={`${base}/maps`} class="text-sm text-primary hover:text-primary-dark font-medium">View all →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {latest.map((map) => <MapCard map={map} />)}
      </div>
    </section>
  )}

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="rounded-2xl bg-surface border border-border p-7 sm:p-10">
      <p class="text-sm font-semibold tracking-wide uppercase text-primary">Creative practice</p>
      <h2 class="font-display text-2xl sm:text-3xl font-semibold mt-3">Barefoot shoemaking & circular footwear</h2>
      <p class="mt-4 text-text-muted max-w-2xl leading-relaxed">
        A developing portfolio for tactile, repair-minded work at the intersection of movement,
        materials, and circular design.
      </p>
      <a href={`${base}/shoemaking`} class="inline-block mt-6 text-sm font-medium text-primary hover:text-primary-dark">
        View the shoemaking portfolio →
      </a>
    </div>
  </section>
</BaseLayout>

