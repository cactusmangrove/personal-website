---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MapCard from '../../components/MapCard.astro';

const maps = (await getCollection('maps', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Maps — Your Name"
  description="A customizable gallery for maps, data visualizations, and project stories."
>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pt-16 pb-12">
    <h1 class="font-display text-3xl sm:text-4xl font-bold">Maps</h1>
    <p class="mt-4 text-text-muted max-w-2xl">
      Use these template articles as a starting point for static cartography and
      interactive web maps. Replace the previews, metadata, and prose with your work.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
      {maps.map((map) => <MapCard map={map} />)}
    </div>
    {maps.length === 0 && (
      <p class="mt-10 text-text-muted">No maps published yet — check back soon.</p>
    )}
  </section>
</BaseLayout>
